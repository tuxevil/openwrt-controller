#!/bin/sh
# =============================================================================
# NERVE CENTER - ZERO-TOUCH FIRST BOOT SCRIPT
# Location in image: /etc/uci-defaults/99-nerve-center-bootstrap
#
# This script runs ONCE on first boot via the uci-defaults mechanism.
# After it exits 0, OpenWrt deletes it automatically — it never runs again.
#
# Fill in the variables below before building the image in OpenWrt Image Builder.
# =============================================================================

# ── MANDATORY CONFIGURATION ──────────────────────────────────────────────────
CONTROLLER_URL="https://controller.example.com:8443/api"
REQUIRE_TLS="true"
CONTROLLER_CA_FILE=""
CONTROLLER_PINNED_PUBKEY=""
SITE_ENROLLMENT_TOKEN="REPLACE_WITH_SITE_ENROLLMENT_TOKEN" # Short-lived site bootstrap credential
AGENT_UPDATE_PUBLIC_KEY="oTOq5fQzxDOLLxdnTSiGow6l70MKjgl1sRh7Yg6NEws="

# ── OPTIONAL CONFIGURATION ───────────────────────────────────────────────────
ROOT_PASSWORD=""   # Set explicitly only when password login is required
# PPPoE credentials (leave blank if WAN is DHCP)
PPPOE_USERNAME=""
PPPOE_PASSWORD=""

# =============================================================================
# DO NOT EDIT BELOW THIS LINE
# =============================================================================
exec >/tmp/nerve-bootstrap.log 2>&1

CONTROLLER_URL="${CONTROLLER_URL%/}"
BASE_URL="$CONTROLLER_URL"
AGENT_METADATA_URL="$BASE_URL/agent/latest"
AGENT_URL="$BASE_URL/agent/latest/raw"
AGENT_DEST="/usr/sbin/nerve-agent.sh"
AGENT_CONFIG_FILE="/etc/nerve/agent.conf"
AGENT_UPDATE_PUBLIC_KEY_FILE="/etc/nerve/agent-update-public-key"
ENROLLMENT_TOKEN_FILE="/etc/nerve/enrollment-token"
ENROLLMENT_NONCE_FILE="/etc/nerve/enrollment-nonce"

echo "[*] NERVE CENTER ZERO-TOUCH BOOTSTRAP STARTING..."

decode_base64() {
  if command -v base64 >/dev/null 2>&1; then
    base64 -d
  elif command -v openssl >/dev/null 2>&1; then
    openssl base64 -d -A
  else
    return 1
  fi
}

tls_required() {
  case "$REQUIRE_TLS" in
    1|true|TRUE|yes|YES) return 0 ;;
    0|false|FALSE|no|NO) return 1 ;;
    *) return 2 ;;
  esac
}

validate_controller_url() {
  case "$REQUIRE_TLS" in
    1|true|TRUE|yes|YES|0|false|FALSE|no|NO) ;;
    *) return 1 ;;
  esac
  case "$CONTROLLER_URL" in
    https://*|http://*) ;;
    *) return 1 ;;
  esac
  case "$CONTROLLER_URL" in
    https://|http://|*[!A-Za-z0-9:/._-]*) return 1 ;;
  esac
  case "$CONTROLLER_URL" in
    http://*)
      case "$REQUIRE_TLS" in
        1|true|TRUE|yes|YES) return 1 ;;
      esac
      ;;
  esac
  if [ -n "$CONTROLLER_CA_FILE" ] && [ ! -r "$CONTROLLER_CA_FILE" ]; then
    return 1
  fi
}

controller_curl() {
  if [ -n "$CONTROLLER_CA_FILE" ]; then
    set -- --cacert "$CONTROLLER_CA_FILE" "$@"
  fi
  if [ -n "$CONTROLLER_PINNED_PUBKEY" ]; then
    set -- --pinnedpubkey "$CONTROLLER_PINNED_PUBKEY" "$@"
  fi
  curl "$@"
}

verify_agent_artifact() {
  artifact_file="$1"
  signature_base64="$2"
  public_key_base64="$3"
  verify_dir="/tmp/nerve-bootstrap-verify.$$"
  mkdir "$verify_dir" 2>/dev/null || return 1
  if ! printf '%s' "$public_key_base64" | decode_base64 > "$verify_dir/public.raw" 2>/dev/null; then
    rm -rf "$verify_dir"
    return 1
  fi
  public_key_size=$(wc -c < "$verify_dir/public.raw")
  if [ "$public_key_size" -ne 32 ]; then
    rm -rf "$verify_dir"
    return 1
  fi
  printf '\060\052\060\005\006\003\053\145\160\003\041\000' > "$verify_dir/public.der" || {
    rm -rf "$verify_dir"
    return 1
  }
  cat "$verify_dir/public.raw" >> "$verify_dir/public.der" || {
    rm -rf "$verify_dir"
    return 1
  }
  if ! printf '%s' "$signature_base64" | decode_base64 > "$verify_dir/signature" 2>/dev/null; then
    rm -rf "$verify_dir"
    return 1
  fi
  signature_size=$(wc -c < "$verify_dir/signature")
  if [ "$signature_size" -ne 64 ] || ! command -v openssl >/dev/null 2>&1; then
    rm -rf "$verify_dir"
    return 1
  fi
  openssl pkeyutl -verify -pubin -inkey "$verify_dir/public.der" -rawin \
    -in "$artifact_file" -sigfile "$verify_dir/signature" >/dev/null 2>&1
  verify_status=$?
  rm -rf "$verify_dir"
  return "$verify_status"
}

if [ "${1:-}" = "--self-test-signature" ]; then
  [ "$#" -eq 4 ] || exit 1
  verify_agent_artifact "$2" "$3" "$4"
  exit $?
fi

if ! validate_controller_url; then
  echo "[!] Invalid controller URL or TLS policy."; exit 1
fi
if [ "$ROOT_PASSWORD" = "REPLACE_WITH_SECURE_PASSWORD" ]; then
  echo "[!] Replace the root password placeholder or leave ROOT_PASSWORD empty."; exit 1
fi
case "$SITE_ENROLLMENT_TOKEN" in
  ''|REPLACE_WITH_SITE_ENROLLMENT_TOKEN|*[!A-Za-z0-9_-]*) echo "[!] Site enrollment token is not configured."; exit 1 ;;
esac
case "$AGENT_UPDATE_PUBLIC_KEY" in
  ''|*[!A-Za-z0-9+/=]*) echo "[!] Agent update public key is not configured."; exit 1 ;;
esac

# 1. Set root password
if [ -n "$ROOT_PASSWORD" ]; then
  (echo "$ROOT_PASSWORD"; sleep 1; echo "$ROOT_PASSWORD") | passwd >/dev/null 2>&1
  echo "[+] Root password configured."
fi

# 2. Configure PPPoE WAN if credentials provided
if [ -n "$PPPOE_USERNAME" ] && [ -n "$PPPOE_PASSWORD" ]; then
  uci set network.wan.proto=pppoe
  uci set network.wan.username="$PPPOE_USERNAME"
  uci set network.wan.password="$PPPOE_PASSWORD"
  uci commit network
  echo "[+] PPPoE WAN configured."
fi

# 3. Disable the default OpenWrt SSID on first boot
#    The controller will push the correct SSID via config after adoption.
uci set wireless.@wifi-device[0].disabled='1' 2>/dev/null
uci commit wireless 2>/dev/null
echo "[+] Wireless disabled pending controller configuration."

# 4. Wait for WAN connectivity (check the controller host)
echo "[*] Waiting for network connectivity..."
MAX_WAIT=120
WAITED=0
CONTROLLER_HOST=$(printf '%s\n' "$CONTROLLER_URL" | sed -e 's#^[A-Za-z][A-Za-z0-9+.-]*://##' -e 's#/.*$##' -e 's#:[0-9][0-9]*$##')
while ! ping -c 1 -W 2 "$CONTROLLER_HOST" >/dev/null 2>&1; do
  sleep 3
  WAITED=$((WAITED + 3))
  if [ $WAITED -ge $MAX_WAIT ]; then
    echo "[!] Timeout waiting for controller host $CONTROLLER_HOST. Bootstrap deferred."
    # Exit 1 so the script is NOT deleted and retries on next boot
    exit 1
  fi
done
echo "[+] Controller reachable at $CONTROLLER_HOST."

# 5. Download the latest agent from the Nerve Center
# Install required packages for remote diagnostics
echo "[*] Installing required packages..."
opkg update && if opkg list-installed | grep -q "wpad-basic"; then opkg remove wpad-basic-wolfssl wpad-basic-mbedtls; opkg install wpad-mesh-wolfssl; fi; opkg install tcpdump curl jsonfilter openssl-util iperf3 sqm-scripts kmod-sched-cake iptables-mod-ndpi tailscale >/dev/null 2>&1 || true

echo "[*] Downloading signed Nerve Center agent metadata..."
AGENT_METADATA_FILE="/tmp/nerve-agent-metadata.$$"
if ! controller_curl -m 15 -fsS \
    -H "X-Site-Enrollment-Token: $SITE_ENROLLMENT_TOKEN" \
    -o "$AGENT_METADATA_FILE" \
    "$AGENT_METADATA_URL"; then
  echo "[!] Agent metadata download failed. Bootstrap deferred."
  rm -f "$AGENT_METADATA_FILE"
  exit 1
fi
LATEST_HASH=$(jsonfilter -i "$AGENT_METADATA_FILE" -e '@.version_hash' 2>/dev/null || true)
LATEST_SIGNATURE=$(jsonfilter -i "$AGENT_METADATA_FILE" -e '@.signature' 2>/dev/null || true)
LATEST_SIGNATURE_ALGORITHM=$(jsonfilter -i "$AGENT_METADATA_FILE" -e '@.signature_algorithm' 2>/dev/null || true)
if [ -z "$LATEST_HASH" ] || [ -z "$LATEST_SIGNATURE" ] || [ "$LATEST_SIGNATURE_ALGORITHM" != "Ed25519" ]; then
  echo "[!] Agent metadata is unsigned or malformed. Bootstrap deferred."
  rm -f "$AGENT_METADATA_FILE"
  exit 1
fi

echo "[*] Downloading signed Nerve Center agent artifact..."
if ! controller_curl -m 15 -fsS \
    -H "X-Site-Enrollment-Token: $SITE_ENROLLMENT_TOKEN" \
    -o "${AGENT_DEST}.tmp" \
    "$AGENT_URL"; then
  echo "[!] Agent download failed. Bootstrap deferred."
  rm -f "$AGENT_METADATA_FILE" "${AGENT_DEST}.tmp"
  exit 1
fi
rm -f "$AGENT_METADATA_FILE"
if [ ! -s "${AGENT_DEST}.tmp" ]; then
  echo "[!] Agent download empty. Bootstrap deferred."
  rm -f "${AGENT_DEST}.tmp"
  exit 1
fi
if [ "$(sha256sum "${AGENT_DEST}.tmp" | awk '{print $1}')" != "$LATEST_HASH" ] || \
    ! verify_agent_artifact "${AGENT_DEST}.tmp" "$LATEST_SIGNATURE" "$AGENT_UPDATE_PUBLIC_KEY"; then
  echo "[!] Agent artifact hash or signature verification failed. Bootstrap deferred."
  rm -f "${AGENT_DEST}.tmp"
  exit 1
fi
if ! chmod 755 "${AGENT_DEST}.tmp"; then
  echo "[!] Could not make the verified agent executable. Bootstrap deferred."
  rm -f "${AGENT_DEST}.tmp"
  exit 1
fi
if ! mv "${AGENT_DEST}.tmp" "$AGENT_DEST"; then
  echo "[!] Could not install the verified agent. Bootstrap deferred."
  rm -f "${AGENT_DEST}.tmp"
  exit 1
fi
echo "[+] Signed agent verified and installed → $AGENT_DEST"

# 6. Runtime credentials stay outside the signed artifact. The enrollment
# token is removed by the agent after the first successful enrollment.
umask 077
if ! mkdir -p /etc/nerve; then
  echo "[!] Could not create the runtime configuration directory. Bootstrap deferred."
  exit 1
fi
if ! printf 'CONTROLLER_URL="%s"\nREQUIRE_TLS="%s"\nCONTROLLER_CA_FILE="%s"\nCONTROLLER_PINNED_PUBKEY="%s"\nDEVICE_ID_FILE="/etc/nerve-device-id"\nDEVICE_TOKEN_FILE="/etc/nerve-device-token"\nENROLLMENT_TOKEN_FILE="%s"\nENROLLMENT_NONCE_FILE="%s"\nAGENT_UPDATE_PUBLIC_KEY_FILE="%s"\n' \
  "$CONTROLLER_URL" "$REQUIRE_TLS" "$CONTROLLER_CA_FILE" "$CONTROLLER_PINNED_PUBKEY" "$ENROLLMENT_TOKEN_FILE" "$ENROLLMENT_NONCE_FILE" "$AGENT_UPDATE_PUBLIC_KEY_FILE" > "$AGENT_CONFIG_FILE"; then
  echo "[!] Could not persist the agent runtime configuration. Bootstrap deferred."
  exit 1
fi
if ! printf '%s\n' "$SITE_ENROLLMENT_TOKEN" > "$ENROLLMENT_TOKEN_FILE" || \
    ! printf '%s\n' "$AGENT_UPDATE_PUBLIC_KEY" > "$AGENT_UPDATE_PUBLIC_KEY_FILE"; then
  echo "[!] Could not persist the bootstrap credentials. Bootstrap deferred."
  exit 1
fi
if ! chmod 600 "$AGENT_CONFIG_FILE" "$ENROLLMENT_TOKEN_FILE" "$AGENT_UPDATE_PUBLIC_KEY_FILE"; then
  echo "[!] Could not protect the bootstrap credentials. Bootstrap deferred."
  exit 1
fi
echo "[+] Runtime credentials stored outside the signed agent artifact."

# 7. Register service via procd (rc.local fallback for simplicity)
#    Creates a procd-compatible init script so the agent survives reboots.
if ! cat > /etc/init.d/nerve-agent << 'EOF'
#!/bin/sh /etc/rc.common
START=99
STOP=10
USE_PROCD=1

start_service() {
  procd_open_instance
  procd_set_param command /usr/sbin/nerve-agent.sh
  procd_set_param respawn 60 5 0
  procd_set_param stdout 1
  procd_set_param stderr 1
  procd_close_instance
}
EOF
then
  echo "[!] Could not create the agent service. Bootstrap deferred."
  exit 1
fi
if ! chmod +x /etc/init.d/nerve-agent; then
  echo "[!] Could not enable the agent service. Bootstrap deferred."
  exit 1
fi
if ! /etc/init.d/nerve-agent enable; then
  echo "[!] Could not register the agent service. Bootstrap deferred."
  exit 1
fi
if ! /etc/init.d/nerve-agent start; then
  echo "[!] Could not start the agent service. Bootstrap deferred."
  exit 1
fi

echo "[+] Nerve agent service registered and started; enrollment is handled before telemetry."
echo "[✓] NERVE CENTER ZERO-TOUCH BOOTSTRAP COMPLETE."

# Exit 0 → OpenWrt deletes this script. It will NOT run again on next boot.
exit 0
