#!/bin/sh /etc/rc.common
USE_PROCD=1
START=18
STOP=89
start_service() {
    /usr/sbin/agent-config-guard boot || return 1
    procd_open_instance
    procd_set_param command /usr/sbin/agent-config-guard worker
    procd_set_param respawn 3600 2 0
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}
